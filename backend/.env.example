PORT=4000
# true = sans PostgreSQL (démo locale) | false = PostgreSQL + bootstrap auto au démarrage
USE_MEMORY=true
DATABASE_URL=postgresql://tariki:tariki_secret@localhost:5433/tariki_traffic
JWT_SECRET=change-me-in-production-tariki-2026
JWT_EXPIRES_IN=8h
# Code organisation (obligatoire à la connexion si défini)
# Code admin (connexion + inscription admin) — partagé équipe démo
ADMIN_ACCESS_CODE=0000
CORS_ORIGIN=http://localhost:5173
SIMULATION_INTERVAL_MS=3000
TARIKI_DEFAULT_DAY=monday
# TARIKI_DATASET_PATH=/chemin/vers/datasets

# Données externes (webcams ADM, MapCam, météo Open-Meteo, POI OSM)
ADM_TRAFIC_ORIGIN=http://admtrafic.ma
MAPCAM_ORIGIN=https://www.mapcam.info
ADM_WEBCAM_RADIUS_KM=85

# Chatbot (optionnel — sans clé = IA locale gratuite)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
